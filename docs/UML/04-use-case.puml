@startuml GitEasyUseCase
title GitEasy - Use Case View (v1.5.5)
skinparam packageStyle rectangle
skinparam shadowing false
left to right direction

actor "Non-Git user\n(sysadmin / DBA /\ncompliance officer)" as User
actor "CI / automation\nscript" as CI
actor "Remote peer\n(team member)" as Peer

rectangle "GitEasy" {
  usecase "Save work" as UC1
  usecase "Check what changed" as UC2
  usecase "View and search history" as UC3
  usecase "Get team updates" as UC4
  usecase "Set up credential storage" as UC5
  usecase "Configure published location" as UC6
  usecase "Verify connectivity" as UC7
  usecase "Create a release marker" as UC8
  usecase "Manage working areas" as UC9
  usecase "Recover files" as UC10
  usecase "Clean ignored files" as UC11
  usecase "Inspect diagnostics" as UC12
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10
User --> UC11
User --> UC12

CI --> UC1 : Save-Work -NoPush\nor full push
CI --> UC2
CI --> UC7

Peer --> UC4 : indirect — peer pushes to remote;\nGet-Updates fetches the result

note right of UC1
  Save-Work: stage all, commit,\npull-rebase if upstream exists, push.\n-NoPush skips publish.
end note

note right of UC5
  Set-Vault chooses storage backend.\nReset-Login clears a stale entry.
end note

note right of UC6
  Set-Token (HTTPS) or Set-Ssh.\nBoth reject embedded credentials.
end note
@enduml
