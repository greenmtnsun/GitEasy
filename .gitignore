*.bak
/Wiki/
/New-GitEasyWiki.ps1
/coverage.txt
# .claude/ stays local except the portable kit from claude-config (hooks, skills, wiring, global rules)
.claude/*
!.claude/hooks/
!.claude/skills/
!.claude/settings.json
!.claude/CLAUDE-global.md
!.claude/kit-manifest.json

# Derived doc artifacts. PDFs are regenerated at publish time by
# tools/Build-DocsPdf.ps1 from the Markdown sources and ship in the
# .nupkg only; they do not belong in the source tree.
/docs/*.pdf
/docs/*.tmp.html
.wrangler/
HANDOFF-*.md
